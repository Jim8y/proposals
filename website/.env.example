# GitHub API Configuration
REACT_APP_GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=your_github_token_here

# Auth0 Configuration
REACT_APP_AUTH0_DOMAIN=your-auth0-domain.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your_auth0_client_id_here
REACT_APP_AUTH0_AUDIENCE=https://api.nep.neo.org
REACT_APP_AUTH0_CALLBACK_URL=http://localhost:3000/callback
REACT_APP_AUTH0_LOGOUT_URL=http://localhost:3000

# FaunaDB Configuration
FAUNA_SECRET=your_fauna_secret_key_here

# Site Configuration
SITE_URL=http://localhost:3000
NODE_ENV=development
